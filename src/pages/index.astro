---
import '../styles/global.css'
import WhatsAppIcon from '../components/WhatsAppIcon.astro'
import ArrowIcon from '../components/ArrowIcon.astro'
import SectionIntro from '../components/SectionIntro.astro'
import InfoBlock from '../components/InfoBlock.astro'
import ContactRow from '../components/ContactRow.astro'
import SocialLinks from '../components/SocialLinks.astro'

const whatsappUrl = 'https://wa.me/5493794753254'
const mapsUrl = 'https://www.google.com/maps/place/C%C3%B3rdoba+1491,+W3400+Corrientes'
const mapsEmbedUrl = 'https://www.google.com/maps?q=C%C3%B3rdoba+1491,+W3400+Corrientes,+Argentina&output=embed'

const supplyLines = [
  {
    title: 'Medicamentos',
    items: ['Ampollas y soluciones inyectables', 'Comprimidos en caja cerrada', 'Jarabes y suspensiones', 'Cremas y ungüentos'],
    label: 'Habilitación ANMAT · tránsito interjurisdiccional',
  },
  {
    title: 'Equipamiento y cuidado de la salud',
    items: ['Terapia intensiva: respiradores, monitores, carros de paro', 'Quirófano: mesas, lámparas scialíticas, instrumental', 'Oxigenoterapia y anestesia', 'Ortopedia, rehabilitación y medicina deportiva', 'Diagnóstico: tensiómetros, oxímetros, glucómetros'],
    label: 'Venta mayorista y minorista',
  },
  {
    title: 'Insumos médicos y descartables',
    items: ['Descartables: jeringas, agujas, catéteres, sondas', 'Curaciones: gasas, apósitos, vendas, telas adhesivas', 'Antisépticos y soluciones', 'Esterilización: bolsas, pouch, indicadores, selladoras', 'Protección personal e indumentaria'],
    label: 'Reposición programada para instituciones',
  },
]

const milestones = [
  ['1990', 'Juan Moriondo funda Científica Movi.'],
  ['1998', 'La empresa adquiere su local comercial. '],
  ['2001', 'Expande su operación a toda la región.'],
  ['2010', 'Marianela Moriondo se suma al proyecto iniciando un proceso de profesionalización.'],
]

// Cada tramo del eje es proporcional a los años reales hasta el próximo hito (el último reutiliza
// el tramo anterior, solo para darle aire al texto) — así el eje muestra el ritmo real de la historia
// en vez de espaciar los hitos de forma pareja.
const milestoneSpans = milestones.map(([year], i) =>
  i < milestones.length - 1
    ? Number(milestones[i + 1][0]) - Number(year)
    : Number(year) - Number(milestones[i - 1][0])
)
const timelineColumns = milestoneSpans.map((span) => `minmax(150px, ${span}fr)`).join(' ')

const metrics = [
  ['36', 'años', 'De trayectoria ininterrumpida en el nordeste argentino'],
  ['5', 'provincias', 'Corrientes, Chaco, Formosa, Misiones y norte de Santa Fe'],
  ['+1000', 'm²', 'Depósito y oficinas propias'],
  ['+700', 'clientes', 'Que confian en nuestros productos y servicios'],
]

const facilities = [
  ['360 m²', 'Oficinas propias en Córdoba y Rivadavia, sede de administración y coordinación logística.'],
  ['730 m²', 'Depósito propio sobre Av. Maipú, con stock permanente en nuestras tres líneas de productos.'],
  ['Flota Propia', 'Para distribución local y de larga distancia en todo el Nordeste argentino.'],
]

// TODO: actualizar cuando se conecte el dominio propio (ver CLAUDE.md → Deploy)
const siteUrl = 'https://lightblue-eland-599476.hostingersite.com'
const pageTitle = 'Científica Movi | Droguería al servicio de la salud del Nordeste'
const pageDescription = 'Droguería habilitada por ANMAT. Medicamentos, equipamiento e insumos médicos desde Corrientes para todo el Nordeste argentino.'
const ogImage = `${siteUrl}/images/movi-building.webp`

// Coincide con los datos visibles en la sección Contacto — si esos cambian, actualizar también acá.
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Pharmacy',
  '@id': `${siteUrl}/#organization`,
  name: 'Científica Movi',
  description: pageDescription,
  url: siteUrl,
  image: ogImage,
  telephone: '+543794434313',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Córdoba 1491, esquina Rivadavia',
    addressLocality: 'Corrientes',
    addressRegion: 'Corrientes',
    postalCode: 'W3400',
    addressCountry: 'AR',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '12:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '16:00',
      closes: '20:30',
    },
  ],
  sameAs: [
    'https://www.instagram.com/cientificamovi/',
    'https://www.facebook.com/cientificamovisrl',
  ],
}
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#00205C" />
    <link rel="icon" href="/favicon.ico" sizes="any" /> 
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" /> 
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" /> 
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Científica Movi" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="576" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
  </head>
  <body>
    <main>
      <header class="site-header">
        <div class="container header-inner">
          <a href="#inicio" class="brand" aria-label="Científica Movi, inicio"> 
          <img src="/images/movi-logo.png" alt="Científica Movi, Droguería y Científica" class="brand-logo" /> </a>
          <nav id="main-menu" class="main-nav" aria-label="Navegación principal">
            <a href="#proveemos">Qué proveemos</a>
            <a href="#cobertura">Cobertura</a>
            <a href="#nosotros">Nuestra Historia</a>
            <a href="#contacto">Contacto</a>
          </nav>
          <a class="header-whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer">
            <WhatsAppIcon /> <span>WhatsApp</span>
          </a>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu">
            <span class="sr-only">Abrir menú</span><span></span><span></span><span></span>
          </button>
        </div>
      </header>

      <section class="hero" id="inicio">
        <div class="hero-image" role="img" aria-label="Edificio comercial de Científica Movi en Corrientes"></div>
        <div class="hero-overlay"></div>
        <div class="container hero-content">
          <p class="eyebrow light">Droguería · Corrientes, Argentina</p>
          <h1>Al servicio de la salud del Nordeste desde <span>1990</span></h1>
          <p class="hero-copy">Droguería habilitada por ANMAT. Proveemos medicamentos, equipamiento e insumos médicos a hospitales,  clinicas, sanatorios, farmacias y profesionales de la salud de cinco provincias, con depósito y flota propios en Corrientes.</p>
          <div class="hero-actions">
            <a class="button button-cyan" href={whatsappUrl} target="_blank" rel="noreferrer">
              <WhatsAppIcon /> Pedir un presupuesto
            </a>
            <a class="button button-ghost" href="#proveemos">Ver qué proveemos <ArrowIcon /></a>
          </div>
        </div>
        <div class="metrics">
          <div class="container metrics-grid">
            {metrics.map(([number, unit, label]) => (
              <div class="metric">
                <div><strong>{number}</strong>{unit && <sup>{unit}</sup>}</div>
                <span>{label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section supplies" id="proveemos">
        <div class="container">
          <SectionIntro
            kicker="Qué proveemos"
            title="Tres líneas, un solo proveedor"
            copy="Un catálogo pensado para resolver las necesidades cotidianas del sistema de salud, profesionales y familias de la región"
          />
          <div class="supply-grid">
            {supplyLines.map((line) => (
              <article class="supply-column">
                <h3>{line.title}</h3>
                <ul>
                  {line.items.map((item) => <li>{item}</li>)}
                </ul>
                <p class="supply-label">{line.label}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section coverage" id="cobertura">
        <div class="container">
          <SectionIntro
            kicker="Cobertura"
            title="Logística Propia.<br />Reposición Inmediata."
            copy="Directo desde nuestros depósitos en Corrientes.
             Menos escalas, menos demoras, 36 años trabajando así."
          />
          <div class="coverage-grid">
            <div class="coverage-map-col">
              <div class="map-diagram province-map" aria-label="Mapa tridimensional de cobertura en Corrientes, Chaco, Formosa, Misiones y el norte de Santa Fe">
                <div class="province-map-heading">
                  <span class="map-kicker">Cobertura regional</span>
                  <strong>5 provincias conectadas </strong>
                </div>
                <div class="province-stage">
                  <svg class="regional-map-figures" viewBox="0 0 520 360" role="img" aria-label="Mapa con los límites reales de Formosa, Chaco, Corrientes, Misiones y el norte de Santa Fe">
                    <g class="map-extrusion" transform="translate(0 9)">
                      <path d="M292.1 130.0 283.8 118.1 267.2 114.2 205.6 74.6 171.4 66.6 122.1 14.0 122.3 77.3 163.7 100.9 229.4 168.6 237.1 166.6 267.6 189.9 275.0 160.7 294.5 136.6Z"></path>
                      <path d="M122.1 77.3 163.7 100.8 219.0 160.5 251.6 178.1 265.8 190.1 247.8 214.5 248.2 236.0 145.0 235.4 144.9 140.7 83.4 140.6 122.2 89.9Z"></path>
                      <path d="M285.0 346.0 271.3 326.9 259.7 323.1 222.2 334.4 218.4 329.8 220.8 292.3 236.1 276.4 238.6 245.5 249.7 231.0 248.4 214.1 276.9 204.8 319.3 218.6 349.0 207.6 350.3 215.7 365.1 241.6 359.0 245.8 362.2 252.3 355.6 249.9 303.7 309.4 283.0 336.1Z"></path>
                      <path d="M351.2 209.0 360.2 213.7 367.3 198.1 394.3 181.1 401.6 163.2 399.8 140.5 407.9 142.7 419.4 134.1 436.6 163.6 433.2 196.0 412.8 213.3 394.2 216.6 367.4 242.2 360.3 238.8Z"></path>
                      <path d="M138.5 275.9 144.3 235.3 246.5 235.6 240.4 250.1 235.4 275.9Z"></path>
                    </g>
                    <g class="map-faces">
                      <path class="figure-formosa" d="M292.1 130.0 283.8 118.1 267.2 114.2 205.6 74.6 171.4 66.6 122.1 14.0 122.3 77.3 163.7 100.9 229.4 168.6 237.1 166.6 267.6 189.9 275.0 160.7 294.5 136.6Z"></path>
                      <path class="figure-chaco" d="M122.1 77.3 163.7 100.8 219.0 160.5 251.6 178.1 265.8 190.1 247.8 214.5 248.2 236.0 145.0 235.4 144.9 140.7 83.4 140.6 122.2 89.9Z"></path>
                      <path class="figure-corrientes" d="M285.0 346.0 271.3 326.9 259.7 323.1 222.2 334.4 218.4 329.8 220.8 292.3 236.1 276.4 238.6 245.5 249.7 231.0 248.4 214.1 276.9 204.8 319.3 218.6 349.0 207.6 350.3 215.7 365.1 241.6 359.0 245.8 362.2 252.3 355.6 249.9 303.7 309.4 283.0 336.1Z"></path>
                      <path class="figure-misiones" d="M351.2 209.0 360.2 213.7 367.3 198.1 394.3 181.1 401.6 163.2 399.8 140.5 407.9 142.7 419.4 134.1 436.6 163.6 433.2 196.0 412.8 213.3 394.2 216.6 367.4 242.2 360.3 238.8Z"></path>
                      <path class="figure-santa" d="M138.5 275.9 144.3 235.3 246.5 235.6 240.4 250.1 235.4 275.9Z"></path>
                    </g>
                  </svg>
                  <span class="map-region-label label-formosa">Formosa</span>
                  <span class="map-region-label label-chaco">Chaco</span>
                  <span class="map-region-label label-corrientes">Corrientes</span>
                  <span class="map-region-label label-misiones">Misiones</span>
                  <span class="map-region-label label-santa">Norte de Santa Fe</span>
                </div>
                <div class="map-center">
                  <b>Corrientes</b>
                  <small>depósito Av. Maipú</small>
                </div>
              </div>
            </div>
            <div class="coverage-blocks">
              <InfoBlock index="01" title="Mayorista" tags={["Ejecutivos de Ventas", "Flota propia", "5 provincias"]}>
                Hospitales, clinicas, sanatorios, farmacias, laboratorios, obras sociales y profesionales de la salud de Corrientes, Chaco, Formosa, Misiones y el norte de Santa Fe.
              </InfoBlock>
              <InfoBlock index="02" title="Venta al público" tags={["Atención directa", "Asesoramiento profesional", "Amplio catálogo"]}>
                Venta al público en Córdoba 1491, esquina Rivadavia. Ortopedia, rehabilitación, cuidado domiciliario y accesorios para práctica deportiva.
              </InfoBlock>
            </div>
          </div>
        </div>
      </section>

      <section class="section history" id="nosotros">
        <div class="container">
          <SectionIntro
            kicker="Nuestra historia"
            title="Nacimos en Corrientes.<br />Hoy llegamos a toda la región."
            copy="Cada paso está a la vista en la esquina de Córdoba y Rivadavia."
          />
          <div class="timeline" style={`--timeline-cols:${timelineColumns}`}>
            {milestones.map(([year, text], index) => (
              <article class={`milestone milestone-${index}`}>
                <div class="milestone-bar"></div>
                <span class="milestone-year">{year}</span>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section facilities">
        <div class="container">
          <SectionIntro
            light
            kicker="Nuestra infraestructura"
            title="Infraestructura propia que garantiza continuidad"
            copy="Oficinas, depósito y flota propios —sin intermediarios ni terceros— nos permiten sostener stock permanente y responder con la rapidez que exige cada urgencia sanitaria."
          />
          <div class="facility-grid">
            {facilities.map(([title, text]) => (
              <div class="facility">
                <strong>{title}</strong>
                <p>{text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section contact" id="contacto">
        <div class="container">
          <SectionIntro
            kicker="Contacto"
            title="Pedinos un presupuesto"
            copy="Escribinos por WhatsApp con el detalle de lo que necesitás y te respondemos en el día durante el horario comercial."
          />
          <div class="contact-grid">
            <div class="contact-details">
              <ContactRow label="WhatsApp">
                <a href={whatsappUrl} target="_blank" rel="noreferrer">+54 9 3794 75-7060</a>
              </ContactRow>
              <ContactRow label="Teléfono">
                <a href="tel:+543794434313">3794 434313</a>
                <span> o </span>
                <a href="tel:+543794432869">3794 432869</a>
              </ContactRow>
              <ContactRow label="Dirección">
                Córdoba 1491, esquina Rivadavia, W3400 Corrientes, Argentina<br />
                <a href={mapsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
              </ContactRow>
              <ContactRow label="Atención">
                Lunes a viernes · 8:00 a 12:00 y 16:00 a 20:30
              </ContactRow>
              <ContactRow label="Seguinos en nuestras redes">
                <SocialLinks />
              </ContactRow>
              <a class="button button-navy contact-button" href={whatsappUrl} target="_blank" rel="noreferrer">
                <WhatsAppIcon /> Escribinos por WhatsApp <ArrowIcon />
              </a>
            </div>
            <div class="map-embed">
              <iframe
                src={mapsEmbedUrl}
                title="Ubicación de Científica Movi en Córdoba 1491, Corrientes"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <footer class="site-footer">
        <div class="container">
          <div class="footer-top">
            <div class="brand brand-footer">
               <img src="/images/movi-logo-white.png" alt="Científica Movi, Droguería y Científica" class="brand-logo" />
            </div>
            <div class="footer-claim">Una empresa correntina al servicio<br />de la salud del Nordeste</div>
          </div>
          <div class="legal-grid">
            <p><b>Razón social</b>Científica Movi S.R.L.</p>
            <p><b>CUIT</b>33-64930529-9</p>
            <p><b>Domicilio habilitado</b>Córdoba 1491, Corrientes</p>
            <p><b>Legajo ANMAT</b>171</p>
            <p><b>Dirección técnica</b>Farmaceutica Natalia Ferrari</p>
            <p><b>Habilitaciones</b>Medicamentos y especialidades medicinales; productos médicos y para diagnóstico in vitro</p>
          </div>
          <div class="footer-bottom">
            <span>© 2026 Científica Movi S.R.L. Todos los derechos reservados.</span>
            <SocialLinks light />
            <a href="#inicio">Política de privacidad</a>
          </div>
          <div class="site-credit">
            Sitio realizado por <a href="https://www.indigoconsulting.com.ar/home" target="_blank" rel="noreferrer">Indigo Consulting</a> · Diego Suárez
          </div>
        </div>
      </footer>
    </main>

    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle')
      const nav = document.querySelector<HTMLElement>('.main-nav')

      menuToggle?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('is-open') ?? false
        menuToggle.setAttribute('aria-expanded', String(isOpen))
      })

      nav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          nav.classList.remove('is-open')
          menuToggle?.setAttribute('aria-expanded', 'false')
        })
      })
    </script>
  </body>
</html>
