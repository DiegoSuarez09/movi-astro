---
import IconInstagram from './IconInstagram.astro'
import IconFacebook from './IconFacebook.astro'

interface Props {
  light?: boolean
}
const { light = false } = Astro.props

const links = [
  { label: 'Instagram', href: 'https://www.instagram.com/cientificamovi/', Icon: IconInstagram },
  { label: 'Facebook', href: 'https://www.facebook.com/cientificamovisrl', Icon: IconFacebook },
]
---

<ul class={`social-links ${light ? 'social-links-light' : ''}`}>
  {links.map(({ label, href, Icon }) => (
    <li>
      <a class="social-link" href={href} target="_blank" rel="noreferrer" aria-label={label}>
        <Icon size={20} />
      </a>
    </li>
  ))}
</ul>
